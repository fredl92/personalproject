# Run pt init: creates/repairs placeholders without printing secrets.
# Paths are relative to the toolkit directory, regardless of your current directory.
N8N_VERSION=2.37.7
PENPOT_VERSION=2.17.2
PENPOT_MCP_VERSION=2.17.0
OLLAMA_VERSION=0.33.2
N8N_PORT=5678
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8080
FOOOCUS_PORT=7865
PENPOT_PORT=9001
TZ=Europe/Brussels
N8N_ENCRYPTION_KEY=change-me
PENPOT_SECRET_KEY=change-me
PENPOT_DATABASE_PASSWORD=change-me
WORKER_API_TOKEN=change-me
PLAUSIBLE_SECRET_KEY_BASE=change-me
PLAUSIBLE_BASE_URL=http://localhost:8000
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
WHISPER_MODEL=base
WHISPER_LANGUAGE=nl
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional: 1-32. Empty lets faster-whisper choose. There is no Metal GPU path.
# WHISPER_CPU_THREADS=
# Optional: chrome, chromium, firefox, brave, edge, safari, opera, vivaldi
YTDLP_COOKIES_FROM_BROWSER=
DOWNLOAD_DIR=./downloads
TRANSCRIPTS_DIR=./transcripts
JOBS_DIR=./data/jobs
WHISPER_CACHE_DIR=./data/whisper-cache
