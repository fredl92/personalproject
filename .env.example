# Personal Open-Source Toolkit — copy to .env and customize
# cp .env.example .env

# ── General ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=personal-toolkit
DATA_DIR=./data

# ── n8n (workflow automation) ────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Ollama URL for n8n AI nodes (Docker only — do not set OLLAMA_HOST globally)
N8N_OLLAMA_HOST=http://host.docker.internal:11434

# ── Penpot (open-source Figma) ─────────────────────────────────────────────────
PENPOT_VERSION=2.16
PENPOT_PORT=9001
PENPOT_SECRET_KEY=change-me-generate-64-char-random-string
PENPOT_PUBLIC_URI=http://localhost:9001

# ── Plausible (privacy analytics) ─────────────────────────────────────────────
# Plausible runs in services/plausible/ — see scripts/setup-plausible.sh
PLAUSIBLE_BASE_URL=https://analytics.localhost
PLAUSIBLE_SECRET_KEY_BASE=change-me-generate-with-openssl-rand-base64-48

# ── CLI tool defaults ─────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
DOWNLOAD_DIR=./downloads
TRANSCRIPTS_DIR=./transcripts

# ── Penpot MCP (Cursor integration) ───────────────────────────────────────────
PENPOT_MCP_URL=http://localhost:9001
PENPOT_MCP_TOKEN=
