#!/usr/bin/env bash
# pt — Personal Toolkit unified CLI
# Wraps yt-dlp, Whisper, Ollama, and Docker services from one interface.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${ROOT}/.venv"

if [[ -f "${ROOT}/.env" ]]; then
  # shellcheck disable=SC1091
  set -a
  source "${ROOT}/.env"
  set +a
  # OLLAMA_HOST in .env is for Docker/n8n only — CLI uses localhost
  unset OLLAMA_HOST
fi

DOWNLOAD_DIR="${DOWNLOAD_DIR:-${ROOT}/downloads}"
TRANSCRIPTS_DIR="${TRANSCRIPTS_DIR:-${ROOT}/transcripts}"
WHISPER_MODEL="${WHISPER_MODEL:-base}"
WHISPER_DEVICE="${WHISPER_DEVICE:-cpu}"

activate_venv() {
  if [[ -f "${VENV}/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "${VENV}/bin/activate"
  else
    echo "Run ./scripts/install-cli.sh first" >&2
    exit 1
  fi
}

cmd_download() {
  activate_venv
  mkdir -p "${DOWNLOAD_DIR}"
  local url="${1:?Usage: pt download <url> [yt-dlp options]}"
  shift
  yt-dlp -o "${DOWNLOAD_DIR}/%(title)s.%(ext)s" "$url" "$@"
  echo "Saved to ${DOWNLOAD_DIR}/"
}

cmd_transcribe() {
  activate_venv
  mkdir -p "${TRANSCRIPTS_DIR}"
  local input="${1:?Usage: pt transcribe <audio-or-video-file>}"
  local base
  base="$(basename "${input%.*}")"
  local out="${TRANSCRIPTS_DIR}/${base}.txt"

  python3 - <<PY
from faster_whisper import WhisperModel
import sys

model = WhisperModel("${WHISPER_MODEL}", device="${WHISPER_DEVICE}", compute_type="int8")
segments, info = model.transcribe("${input}", beam_size=5)
print(f"Detected language: {info.language} ({info.language_probability:.0%})", file=sys.stderr)

with open("${out}", "w") as f:
    for seg in segments:
        f.write(f"[{seg.start:.1f}s -> {seg.end:.1f}s] {seg.text.strip()}\n")
        print(seg.text.strip())

print(f"\nTranscript saved: ${out}", file=sys.stderr)
PY
}

cmd_ask() {
  local prompt="${1:?Usage: pt ask <prompt>}"
  local model="${2:-llama3.2:3b}"
  if ! command -v ollama &>/dev/null; then
    echo "Ollama not installed. Run ./scripts/install-cli.sh" >&2
    exit 1
  fi
  OLLAMA_HOST="127.0.0.1:11434" ollama run "${model}" "${prompt}"
}

cmd_pipeline() {
  # Download → transcribe → summarize with Ollama
  local url="${1:?Usage: pt pipeline <video-url>}"
  activate_venv
  mkdir -p "${DOWNLOAD_DIR}" "${TRANSCRIPTS_DIR}"

  echo "==> Downloading..."
  local file
  file="$(yt-dlp -f 'ba' -o "${DOWNLOAD_DIR}/%(id)s.%(ext)s" --print after_move:filepath "${url}")"

  echo "==> Transcribing ${file}..."
  local base transcript
  base="$(basename "${file%.*}")"
  transcript="${TRANSCRIPTS_DIR}/${base}.txt"

  python3 - <<PY
from faster_whisper import WhisperModel
model = WhisperModel("${WHISPER_MODEL}", device="${WHISPER_DEVICE}", compute_type="int8")
segments, _ = model.transcribe("${file}", beam_size=5)
with open("${transcript}", "w") as f:
    for seg in segments:
        f.write(seg.text.strip() + " ")
PY

  echo "==> Summarizing with Ollama..."
  local text
  text="$(cat "${transcript}")"
  OLLAMA_HOST="127.0.0.1:11434" ollama run llama3.2:3b "Summarize this transcript in 5 bullet points:\n\n${text}"

  echo ""
  echo "Full transcript: ${transcript}"
}

cmd_services() {
  local action="${1:-status}"
  cd "${ROOT}"
  case "${action}" in
    up)     docker compose up -d ;;
    down)   docker compose down ;;
    logs)   docker compose logs -f "${2:-}" ;;
    status) docker compose ps ;;
    *)      echo "Usage: pt services [up|down|logs|status]" >&2; exit 1 ;;
  esac
}

cmd_urls() {
  cat <<EOF
Personal Toolkit — service URLs (when running):

  n8n      http://localhost:${N8N_PORT:-5678}     Workflow automation
  Penpot   http://localhost:${PENPOT_PORT:-9001}  Design (Figma alt)
  Plausible http://localhost:8000                 Analytics (after setup-plausible.sh)
  Ollama   http://localhost:11434                 Local LLM API
  Fooocus  http://localhost:7865                  Image gen (GPU, after setup-fooocus.sh)
EOF
}

usage() {
  cat <<EOF
pt — Personal Open-Source Toolkit

Usage:
  pt download <url>           Download video/audio (yt-dlp)
  pt transcribe <file>        Transcribe audio/video (Whisper)
  pt ask <prompt> [model]     Chat with local LLM (Ollama)
  pt pipeline <url>           Download → transcribe → summarize
  pt services [up|down|...]   Manage Docker services (n8n, Penpot)
  pt urls                     Show service URLs
  pt install                  Run CLI tool installer

Examples:
  pt download "https://youtube.com/watch?v=..."
  pt transcribe podcast.mp3
  pt ask "Explain quantum computing simply"
  pt pipeline "https://youtube.com/watch?v=..."
  pt services up
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "${cmd}" in
    download|dl)    cmd_download "$@" ;;
    transcribe|tx)  cmd_transcribe "$@" ;;
    ask|chat)       cmd_ask "$@" ;;
    pipeline|pipe)  cmd_pipeline "$@" ;;
    services|svc)   cmd_services "$@" ;;
    urls)           cmd_urls ;;
    install)        bash "${ROOT}/scripts/install-cli.sh" ;;
    help|-h|--help) usage ;;
    *)              echo "Unknown command: ${cmd}" >&2; usage; exit 1 ;;
  esac
}

main "$@"
